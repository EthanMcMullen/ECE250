{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and run active problem",
      "type": "shell",
      "command": "${workspaceFolder}\\run.ps1",
      "args": ["${relativeFile}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}

